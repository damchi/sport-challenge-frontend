# Public variables only (VITE_* ends up in the bundle). Each ticket adds the ones it reads.

# Address of the backend API (no trailing slash).
VITE_API_URL=http://localhost:8080

# true: answer the API requests with the mocks of src/mocks (development only).
VITE_MOCKS=false

# Auth0 (public values, see the backend docs/auth0-setup.md). Development tenant:
VITE_AUTH0_DOMAIN=
# Client ID of the "Sport Challenge Web" application (Auth0 dashboard, public).
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
