{
  "extraKnownMarketplaces": {
    "damchi": {
      "source": {
        "source": "github",
        "repo": "damchi/claude-library"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "dev-workflow@damchi": true,
    "frontend-review@damchi": true
  },
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm format:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm check)",
      "Bash(pnpm build:*)",
      "Bash(pnpm api:generate)",
      "Bash(pnpm api:sync)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git pull --ff-only)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(ticket config)",
      "Bash(ticket size)",
      "Bash(ticket new:*)",
      "Bash(ticket next)",
      "Bash(ticket start:*)",
      "Bash(ticket tick:*)",
      "Bash(ticket add:*)",
      "Bash(ticket cleanup:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue create:*)",
      "Bash(gh project item-add:*)"
    ],
    "ask": [
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npx:*)",
      "Bash(eas build:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git reset:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push:* main*)",
      "Bash(git push:*:main*)",
      "Bash(git push:* master*)",
      "Bash(git push:*:master*)",
      "Bash(git push:*--delete*)",
      "Bash(git push:* -d *)",
      "Bash(git push:* :*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(git worktree remove:*)",
      "Bash(git am:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow run:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/*.p8)",
      "Read(./**/*.p12)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push:*--force*)",
      "Bash(git push:* -f*)",
      "Bash(git push:* +*)",
      "Bash(git reset:*--hard*)",
      "Bash(git commit:*--no-verify*)",
      "Bash(git push:*--no-verify*)",
      "Bash(gh repo delete:*)",
      "Bash(eas submit:*)",
      "Bash(eas update:*)",
      "Bash(firebase deploy:*)"
    ]
  }
}
